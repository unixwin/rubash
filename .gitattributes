tests/gnu-compat/upstream-rights/*.right -text
tests/gnu-compat/GNU-TIMEOUT.txt -text

# Agent/handoff discipline: keep shell scripts and Rust sources LF in the
# working tree. core.autocrlf=true otherwise re-CRLFs them on checkout, which
# breaks WSL-side test running (bash sees spurious CR => $'\r': command not found).
*.sh eol=lf
*.rs eol=lf
.gitattributes eol=lf
.github/workflows/*.yml eol=lf

# docs/builtins.md is include_str!-ed into the lib (builtin_doc_sync tests).
# A CRLF smudge breaks the "<!-- builtins-list\n" marker search.
docs/builtins.md eol=lf


# third_party/bash upstream tree: normalize to LF so WSL GNU baselines are not
# CR-poisoned (bash treats CRLF script input as data: CR becomes part of words,
# array names, and quoted strings). po/*.gmo are real binaries - leave alone.
third_party/bash/** text eol=lf
third_party/bash/po/*.gmo -text
scripts/git-hooks/* text eol=lf
