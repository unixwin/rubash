#!/bin/sh
# Enforce rustfmt on every commit (owner directive 2026-09-26: fmt must be a
# commit hook). Fails the commit when any Rust source is not formatted.
#
# `cargo fmt --check` enumerates every workspace target; with ~700 test
# targets the spawn command line exceeds the Windows limit and cargo dies
# with "os error 206". When cargo fmt cannot run to completion (nonzero exit
# with no "Diff in" diagnostics), fall back to `rustfmt --edition 2021
# --check` on the .rs files staged in this commit only. The commit passes
# only when every check that ran came back clean.

if ! command -v cargo >/dev/null 2>&1; then
    echo "pre-commit: cargo not found; skipping rustfmt check" >&2
    exit 0
fi

if fmt_out=$(cargo fmt --check 2>&1); then
    exit 0
fi

# cargo fmt failed: real formatting diffs are still a hard block; only an
# operational failure (no "Diff in" lines, e.g. Windows os error 206 spawn
# limit) may use the staged-file fallback.
if printf '%s\n' "$fmt_out" | grep -q 'Diff in '; then
    echo "pre-commit: rustfmt check failed. Run 'cargo fmt' and re-stage." >&2
    printf '%s\n' "$fmt_out" | head -20 >&2
    exit 1
fi

echo "pre-commit: cargo fmt could not run; falling back to staged-file rustfmt check" >&2
printf '%s\n' "$fmt_out" | head -3 >&2

if ! command -v rustfmt >/dev/null 2>&1; then
    echo "pre-commit: rustfmt not found either; skipping rustfmt check" >&2
    exit 0
fi

files=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.rs$')
if [ -z "$files" ]; then
    exit 0
fi

fail=0
while IFS= read -r f; do
    [ -f "$f" ] || continue
    if ! rustfmt --edition 2021 --check "$f" >/dev/null 2>&1; then
        echo "pre-commit: unformatted: $f" >&2
        fail=1
    fi
done <<EOF
$files
EOF

if [ "$fail" -ne 0 ]; then
    echo "pre-commit: rustfmt check failed. Run 'rustfmt --edition 2021 <file>' and re-stage." >&2
    exit 1
fi
exit 0
